<launch>
  <!-- fleet_coordinator 대신 쓰는 충돌 방지 조정 층. 기존 fms_core.launch.xml 은 그대로 두고, 이것을 대신 띄운다.
       map_yaml 이 비어 있으면 fleet_coordinator 와 똑같이 동작한다 (충돌 방지 꺼짐). -->
  <arg name="robots_file" default=""/>
  <arg name="map_yaml" default=""/>
  <arg name="conf_radius" default="0.34"/>
  <arg name="conf_radius_parked" default="0.30"/>
  <arg name="yield_sep" default="0.45"/>   <!-- 0.34(=conf_radius) 에서 상향: 실물에서 비켜선 자리 8 cm 옆을 지나감. 되돌리려면 yield_sep:=0.34 -->
  <arg name="arrive_tol" default="0.25"/>
  <arg name="traffic_mode" default="encounter"/>
  <!-- Nav2 로봇과 차선 로봇이 섞일 때: true 면 차선 미션 중인 로봇을 고정 우선권 로봇으로 보고 Nav2 로봇이 비킨다 (encounter 방식만) -->
  <arg name="lane_robots_as_fixed" default="false"/>   <!-- encounter: 마주쳤을 때만 처리 / predict: 이전 방식(미리 예측해서 피함) -->
  <!-- 차선 주행(Lane Following) 로봇끼리 마주침 조정 (lane_traffic). 둘 중 하나라도 비우면 조정 꺼짐(상태만 발행) -->
  <arg name="lanes_yaml" default=""/>   <!-- 차선만 빈 지도 (mission4_3_lanes_1cm) -->
  <arg name="floor_yaml" default=""/>
  <arg name="escape_wall_margin" default="0.03"/>   <!-- 비켜설 자리 벽 여유 (몸체 반폭 0.06 에 더함, m) -->
  <arg name="escape_block_rects" default=""/>       <!-- 계산에서만 벽으로 막을 영역 "x0,y0,x1,y1;..." (지도 벽 틈). 비우면 막지 않음 -->   <!-- 차선 지운 지도 (mission4_3_nolanes_1cm) -->
  <node pkg="pinky_fms_core" exec="fleet_mission" output="screen"/>
  <node pkg="pinky_fms_traffic" exec="fleet_traffic" output="screen">
    <param name="robots_file" value="$(var robots_file)"/>
    <param name="map_yaml" value="$(var map_yaml)"/>
    <param name="conf_radius" value="$(var conf_radius)"/>
    <param name="conf_radius_parked" value="$(var conf_radius_parked)"/>
    <param name="yield_sep" value="$(var yield_sep)"/>
    <param name="arrive_tol" value="$(var arrive_tol)"/>
    <param name="traffic_mode" value="$(var traffic_mode)"/>
    <param name="lane_robots_as_fixed" value="$(var lane_robots_as_fixed)"/>
  </node>
  <node pkg="pinky_fms_traffic" exec="lane_traffic" output="screen">
    <param name="lanes_yaml" value="$(var lanes_yaml)"/>
    <param name="floor_yaml" value="$(var floor_yaml)"/>
    <param name="escape_wall_margin" value="$(var escape_wall_margin)"/>
    <param name="escape_block_rects" value="$(var escape_block_rects)"/>
  </node>
</launch>
