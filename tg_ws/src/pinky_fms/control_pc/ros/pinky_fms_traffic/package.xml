<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_fms_traffic</name>
  <version>0.0.1</version>
  <description>다중 로봇 충돌·교착 방지 (fleet_traffic: fleet_coordinator 를 상속, 기존 코드는 수정하지 않음)</description>
  <maintainer email="tjkoobro@gmail.com">tkoo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>pinky_fms_interfaces</depend>
  <depend>pinky_fms_core</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
