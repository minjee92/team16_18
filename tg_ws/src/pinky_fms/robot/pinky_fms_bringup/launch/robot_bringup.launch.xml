<?xml version='1.0' ?>
<!--
  pinky_bringup/bringup_robot.launch.xml 을 수정 없이 namespace 안에서 실행하는 래퍼.
  로봇(RPi)에서 실행:
    ros2 launch pinky_fms_bringup robot_bringup.launch.xml namespace:=amr_01

  - 모든 토픽이 /<namespace>/... 로 나간다 (예: /amr_01/odom, /amr_01/battery/percent)
  - TF 는 /<namespace>/tf 로 분리되므로 프레임 이름(odom, base_link ...)은 접두어 없이 그대로 쓴다.
-->
<launch>
    <arg name="namespace" default="amr_01"/>
    <arg name="lcd" default="true"/>
    <arg name="lamp" default="true"/>  <!-- LED 노드: 모든 미션에서 상태를 LED 로 표시 (Nav2 미션은 fms_lcd_status, 차선 미션은 차선 노드가 색을 정함) -->   <!-- 관제(fleet_traffic)의 주행 상태를 LCD 에 표시. emotion 서버 등 LCD 를 쓰는 다른 노드와 같이 쓰지 않는다 -->

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>
        <!-- 안쪽 launch(upload_robot 등)가 같은 이름의 namespace 인자를 다시 적용하지 않도록 비운다 -->
        <let name="namespace" value=""/>
        <set_remap from="/tf" to="tf"/>
        <set_remap from="/tf_static" to="tf_static"/>

        <include file="$(find-pkg-share pinky_bringup)/launch/bringup_robot.launch.xml"/>
    </group>

    <!-- LED 는 장치를 하나의 노드만 열 수 있다: 예전에는 차선 스택이 띄웠으나 이제 여기서 한 번만 띄운다 -->
    <node pkg="pinky_lamp_control" exec="main_node" name="pinky_lamp_control" namespace="$(var namespace)" output="screen" if="$(var lamp)">
        <remap from="/tf" to="tf"/>
        <remap from="/tf_static" to="tf_static"/>
    </node>
    <node pkg="pinky_fms_bringup" exec="fms_lcd_status.py" name="fms_lcd_status" namespace="$(var namespace)" output="screen" if="$(var lcd)"/>
</launch>
