<?xml version='1.0' ?>
<!--
  FMS 미션: Vision-based Lane Following (목적지 왕복). robot_bringup 이 먼저 실행 중이어야 한다.
    ros2 launch pinky_fms_bringup robot_lane.launch.xml namespace:=amr_01 map:=/home/pinky/mission4_3_clean_1cm.yaml
  보통은 GUI 에서 미션을 Vision-based Lane Following 으로 고르면 백엔드가 실행한다 (목적지 없이 대기).
  목적지는 Go 를 누를 때 관제가 lane_cmd 로 보낸다. goal_x/goal_y 를 주면 위치가 잡히는 대로 바로 출발 (터미널 시험용).

  - 위치: Nav2 전체가 아니라 map_server + AMCL 만 띄운다 (관제와 같은 지도 좌표). Init Pose 를 받아야 출발한다.
  - 주행: pinky_autonomous 의 차선 추종을 상속한 fms_lane_mission 노드 (원본 노드는 수정하지 않음).
  - LCD: 이 노드는 LCD 를 쓰지 않는다 (enable_lcd=false). 상태(lane_status)는 fms_lcd_status 가 표시한다.
  - Nav2(robot_nav)와 동시에 띄우지 않는다 (cmd_vel 충돌). 백엔드가 한쪽만 실행한다.
-->
<launch>
    <arg name="namespace" default="amr_01"/>
    <arg name="map" default=""/>
    <arg name="goal_x" default="nan"/>
    <arg name="goal_y" default="nan"/>
    <arg name="goal_arrive_dist" default="0.30"/>
    <arg name="model_path" default="/home/pinky/yolo_drive/best_ncnn_model"/>
    <arg name="drive_speed" default="0.15"/>   <!-- 차선 추종 기준 속도 (m/s). 횡단보도·장애물 감속(×0.5)과 코너 감속도 이 값을 기준으로 한다 -->
    <arg name="return_arrive_dist" default="0.30"/>
    <arg name="yolo_conf" default="0.50"/>   <!-- 차선·횡단보도 검출 최소 신뢰도 (갈림길은 junction_conf 0.35). 로봇마다 원본 기본값이 달라 여기서 고정 -->
    <arg name="run_adc_sensor" default="true"/>
    <!-- 안전 보완 (2026-10-08). 노드 기본값은 예전 동작이고, 이 launch(GUI 미션 경로)에서 켠다 -->
    <arg name="fms_link_timeout" default="2.0"/>       <!-- 미션 중 관제 신호(/fleet/lane_heartbeat)가 이 시간(s) 넘게 없으면 정지. 0 = 끔 (터미널 시험용) -->
    <arg name="traffic_cmd_timeout" default="0.0"/>    <!-- 양보 HOLD 에서 명령이 이 시간(s) 없으면 스스로 재개. 0 = 끔(resume·취소로만). 예전 값 10.0 -->
    <arg name="sonar_zero_stop_count" default="3"/>    <!-- 초음파 0 값(0.02 m 미만)이 이만큼 연속이면 정지. 0 = 항상 무시(예전) -->
    <!-- cmd_vel 안전 게이트 (pinky_fms_lane_robot cmd_vel_gate). 기본 false = 예전처럼 fms_lane_mission 이 cmd_vel 에 직접 낸다.
         true 면 fms_lane_mission 은 cmd_vel_lane 으로 내고, 게이트가 입력 끊김·관제 신호 끊김·초음파 이상·cmd_vel 겹침이면 0 을 낸다.
         로봇에 pinky_fms_lane_robot 이 빌드돼 있어야 한다 -->
    <arg name="use_gate" default="false"/>
    <arg name="gate_link_timeout" default="2.0"/>
    <let name="lane_cmd_vel" value="$(eval '\'cmd_vel_lane\' if \'$(var use_gate)\'.lower() == \'true\' else \'cmd_vel\'')"/>
    <arg name="params_file" default="$(find-pkg-share pinky_fms_bringup)/params/nav2_params.yaml"/>

    <!-- 위치추정만 (map_server + AMCL), namespace 보정은 Nav2 와 같은 래퍼를 쓴다 -->
    <include file="$(find-pkg-share pinky_fms_bringup)/launch/nav2_namespaced.launch.py">
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="map" value="$(var map)"/>
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="nav_launch" value="localization_launch.xml"/>
    </include>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>
        <set_remap from="/tf" to="tf"/>
        <set_remap from="/tf_static" to="tf_static"/>

        <node pkg="pinky_lamp_control" exec="main_node" name="pinky_lamp_control" output="screen"/>
        <node pkg="pinky_sensor_adc" exec="main_node" name="pinky_sensor_adc" output="screen" if="$(var run_adc_sensor)">
            <remap from="batt_state" to="adc/batt_state"/>
        </node>

        <node pkg="pinky_fms_bringup" exec="fms_lane_mission.py" name="fms_lane_mission" output="screen"
              sigterm_timeout="10" sigkill_timeout="15">
            <remap from="cmd_vel" to="$(var lane_cmd_vel)"/>
            <param name="robot_name" value="$(var namespace)"/>
            <param name="goal_x" value="$(var goal_x)"/>
            <param name="goal_y" value="$(var goal_y)"/>
            <param name="goal_arrive_dist" value="$(var goal_arrive_dist)"/>
            <param name="model_path" value="$(var model_path)"/>
            <param name="drive_speed" value="$(var drive_speed)"/>
            <param name="yolo_conf" value="$(var yolo_conf)"/>
            <!-- 앞 사물(초음파 + 라이다 앞 통로, 지도 벽 제외): 0.35 m 감속, 0.15 m 정지, 횡단보도 확인 중 0.30 m 정지 -->
            <param name="obstacle_dist" value="0.35"/>
            <param name="ultrasonic_stop_dist" value="0.15"/>
            <param name="return_arrive_dist" value="$(var return_arrive_dist)"/>
            <param name="fms_link_timeout" value="$(var fms_link_timeout)"/>
            <param name="traffic_cmd_timeout" value="$(var traffic_cmd_timeout)"/>
            <param name="sonar_zero_stop_count" value="$(var sonar_zero_stop_count)"/>
            <param name="enable_return_home" value="true"/>
            <param name="enable_lcd" value="false"/>
            <param name="map_topic" value="map"/>                     <!-- /<ns>/map (map_server, transient_local) -->
            <param name="lane_classes" value="['left_lane', 'right_lane']"/>
            <param name="crosswalk_classes" value="['crosswalk']"/>
            <param name="junction_classes" value="['cross_lane']"/>
        </node>
        <node pkg="pinky_fms_lane_robot" exec="cmd_vel_gate" name="cmd_vel_gate" output="screen" respawn="true"
              respawn_delay="0.5" if="$(var use_gate)">
            <remap from="cmd_vel_in" to="cmd_vel_lane"/>
            <param name="link_timeout" value="$(var gate_link_timeout)"/>
        </node>
    </group>
</launch>
