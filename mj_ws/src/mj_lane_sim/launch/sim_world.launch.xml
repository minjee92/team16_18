<?xml version='1.0' ?>
<!-- 원본: tg_ws/src/pinky_fms/simulation/pinky_fms_sim/launch/sim_world.launch.xml @ fb2f983 (origin/feat/tg-gazebo-course, GPT 작성 pinky_fms_sim). mj_lane_sim 으로 가져와 수정함 — 패키지 이름만 바꿈 -->
<!--
  mission4_3 코스 Gazebo 월드를 띄운다 (한 번만). 로봇은 sim_robot.launch.xml 로 따로 넣는다.
    ros2 launch mj_lane_sim sim_world.launch.xml [gui:=true]
  월드 좌표 = 지도(maps/mission4_3_clean_1cm.yaml) 좌표. 바닥 그림은 지도 벽에 맞춰 보정됨 (SOURCES.md).
  headless 렌더링은 원본 문서에 Gazebo 가 죽었다는 기록이 있어 화면 있는 데스크톱에서 쓴다.
-->
<launch>
    <arg name="world" default="$(find-pkg-share mj_lane_sim)/worlds/mission4_3_textured.sdf"/>
    <arg name="world_name" default="fms_course"/>
    <arg name="gui" default="true"/>
    <arg name="headless_rendering" default="false"/>
    <let name="hr" value="--headless-rendering" if="$(var headless_rendering)"/>
    <let name="hr" value="" unless="$(var headless_rendering)"/>
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share mj_lane_sim)/worlds:$(find-pkg-share pinky_description)/../:$(find-pkg-share pinky_gz_sim)/models:$(env GZ_SIM_RESOURCE_PATH '')"/>
    <set_env name="GZ_SIM_SYSTEM_PLUGIN_PATH" value="$(find-pkg-prefix pinky_gz_sim)/lib:$(env GZ_SIM_SYSTEM_PLUGIN_PATH '')"/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r -s -v3 $(var hr) $(var world)"/>
        <arg name="on_exit_shutdown" value="true"/>
    </include>
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" if="$(var gui)">
        <arg name="gz_args" value="-g -v2"/>
    </include>
    <!-- /clock 은 월드에서 한 번만 -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="clock_bridge" output="screen"
          args="/world/$(var world_name)/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock">
        <remap from="/world/$(var world_name)/clock" to="/clock"/>
    </node>
</launch>
